# Frontend Environment Variables (safe to expose)
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# Backend Environment Variables (set in Netlify dashboard, NOT in .env for production)
# These are listed here for reference only - actual values go in Netlify environment variables
#
# RESEND_API_KEY=your_resend_api_key
# JWT_SECRET=generate_a_secure_random_string_at_least_32_chars
# JWT_VERSION=1
#
# ALLOWED_EMAILS - Comma-separated list of emails allowed to use the app
# ALLOWED_EMAILS=user1@example.com,user2@example.com,user3@example.com
#
# ADMIN_EMAILS - Comma-separated list of admin emails (must also be in ALLOWED_EMAILS)
# Admins can see API usage dashboard and invalidate all sessions
# ADMIN_EMAILS=admin@example.com
#
# ADMIN_NOTIFICATION_EMAIL - Where to send waitlist notifications
# ADMIN_NOTIFICATION_EMAIL=admin+notifications@example.com
